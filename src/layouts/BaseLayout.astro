---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/">Home</a>
        <a href="/publications">Publications</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
  <p>© {new Date().getFullYear()} — Camille Buonomo</p>
</footer>
  </body>
</html>
