---
---

<div class="presentation-container">
  <button
    class="fullscreen-button"
    type="button"
    aria-label="Enter fullscreen presentation"
  >
    ⛶
  </button>

  <button class="pdf-button" type="button">
    ↓ PDF
  </button>

  <div class="slides">
    <slot />
  </div>

  <div class="slide-counter">
    <span id="current-slide">1</span>
    <span>/</span>
    <span id="total-slides"></span>
  </div>
</div>

<script>
  const container = document.querySelector<HTMLElement>(
    ".presentation-container"
  )

  if (container && !container.dataset.initialized) {
    container.dataset.initialized = "true"

    const pdfButton = container.querySelector<HTMLButtonElement>(".pdf-button")
    const fullscreenButton = container.querySelector<HTMLButtonElement>(".fullscreen-button")
    const currentSlideElement = container.querySelector<HTMLElement>("#current-slide")
    const totalSlidesElement = container.querySelector<HTMLElement>("#total-slides")
    const slides = Array.from(container.querySelectorAll<HTMLElement>(".slide"))

    function getSlideNumber(index: number) {
      return slides
        .slice(0, index + 1)
        .filter(slide => !slide.classList.contains("no-counter"))
        .length
    }

    function getTotalSlides() {
      return slides.filter(slide => !slide.classList.contains("no-counter")).length
    }

    let current = 0
    let presentationMode = false

    function showSlide(index: number) {
      if (!slides.length) return

      current = Math.max(0, Math.min(index, slides.length - 1))

      slides.forEach((slide, i) => {
        slide.style.display = presentationMode
          ? (i === current ? "flex" : "none")
          : "flex"
      })

      if (currentSlideElement) {
        currentSlideElement.textContent = String(getSlideNumber(current))
      }

      if (totalSlidesElement) {
        totalSlidesElement.textContent = String(getTotalSlides())
      }
    }

    function getCurrentVisibleSlide() {
      let closestSlide = 0
      let closestDistance = Infinity

      slides.forEach((slide, i) => {
        const distance = Math.abs(
          slide.getBoundingClientRect().top
        )

        if (distance < closestDistance) {
          closestDistance = distance
          closestSlide = i
        }
      })

      return closestSlide
    }

    async function enterFullscreen() {
      current = getCurrentVisibleSlide()
      await container.requestFullscreen()
    }

    async function exitFullscreen() {
      if (document.fullscreenElement) {
        await document.exitFullscreen()
      }
    }

    function handleKey(event: KeyboardEvent) {
      if (!presentationMode) return

      switch (event.key) {
        case "ArrowRight":
        case "ArrowDown":
        case " ":
          event.preventDefault()
          showSlide(current + 1)
          break

        case "ArrowLeft":
        case "ArrowUp":
          event.preventDefault()
          showSlide(current - 1)
          break

        case "Home":
          event.preventDefault()
          showSlide(0)
          break

        case "End":
          event.preventDefault()
          showSlide(slides.length - 1)
          break
      }
    }

    fullscreenButton?.addEventListener("click", async () => {
      if (presentationMode) {
        await exitFullscreen()
      } else {
        await enterFullscreen()
      }
    })

    document.addEventListener("fullscreenchange", () => {
      presentationMode = document.fullscreenElement === container

      container.classList.toggle("presentation-mode", presentationMode)
      showSlide(current)
    })

    document.addEventListener("keydown", handleKey)

    let printState: {
      containerClass: string
      styles: string[]
      pageStyle: HTMLStyleElement
    } | null = null

    async function printPresentation() {
      if (printState) return

      const activeSlide = slides[current] ?? slides[0]
      if (!activeSlide) return

      const rect = activeSlide.getBoundingClientRect()
      const width = rect.width
      const height = rect.height

      const pageStyle = document.createElement("style")

      pageStyle.textContent = `
        @page {
          size: landscape;
          margin: 0;
        }

        @media print {
          html, body {
            margin: 0 !important;
            padding: 0 !important;
          }

          body * {
            visibility: hidden !important;
          }

          .presentation-container,
          .presentation-container * {
            visibility: visible !important;
          }

          .presentation-container {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
          }

          .slides {
            display: block !important;
            width: 100% !important;
          }

          .slide {
            display: flex !important;
            position: relative !important;
            width: 100% !important;
            height: 100vh !important;
            aspect-ratio: auto !important;
            margin: 0 !important;
            overflow: hidden !important;
            break-after: page !important;
            page-break-after: always !important;
          }

          .slide:last-child {
            break-after: auto !important;
            page-break-after: auto !important;
          }

          .fullscreen-button,
          .pdf-button,
          .presentation-container > .slide-counter {
            display: none !important;
          }

          .print-slide-counter {
            display: block !important;
            position: absolute !important;
            right: 1rem !important;
            bottom: 0.5rem !important;
            font-size: 0.9rem !important;
            font-weight: 500 !important;
            opacity: 0.5 !important;
            z-index: 1000 !important;
          }
        }
      `

      printState = {
        containerClass: container.className,
        styles: slides.map(slide => slide.getAttribute("style") ?? ""),
        pageStyle
      }

      document.head.appendChild(pageStyle)

      slides.forEach((slide, i) => {
        const counter = document.createElement("div")
        counter.className = "print-slide-counter"

        if (slide.classList.contains("no-counter")) {
          counter.textContent = ""
        } else {
          counter.textContent = `${getSlideNumber(i)} / ${getTotalSlides()}`
        }

        slide.appendChild(counter)
      })

      slides.forEach(slide => {
        slide.style.setProperty("display", "flex", "important")
        slide.style.setProperty("width", `${width}px`, "important")
        slide.style.setProperty("height", `${height}px`, "important")
        slide.style.setProperty("aspect-ratio", "auto", "important")

        const base = Math.min(width / 100, height / 100 * 16 / 9)
        const fit = getComputedStyle(slide).getPropertyValue("--fit").trim() || "1"

        slide.style.setProperty("--base", `${base}px`, "important")
        slide.style.setProperty("--u", `calc(${base}px * ${fit})`, "important")
      })

      container.classList.remove("presentation-mode")

      await document.fonts.ready
      window.print()
    }

    function restorePresentation() {
      if (!printState) return

      slides.forEach((slide, i) => {
        slide.querySelector(".print-slide-counter")?.remove()

        const style = printState!.styles[i]

        if (style) {
          slide.setAttribute("style", style)
        } else {
          slide.removeAttribute("style")
        }
      })

      container.className = printState.containerClass
      printState.pageStyle.remove()
      printState = null

      showSlide(current)
    }

    pdfButton?.addEventListener("click", printPresentation)
    window.addEventListener("afterprint", restorePresentation)

    showSlide(0)
  }
</script>

<style>
  .presentation-container {
    position: relative;
    width: 100%;
  }

  .slides {
    width: 100%;
  }

  .fullscreen-button {
    position: sticky;
    top: 15rem;
    left: calc(100% - 3.5rem);
    z-index: 1000;
    width: 2.5rem;
    height: 2.5rem;
    margin-top: 5rem;
    margin-bottom: -2.5rem;
    border: none;
    border-radius: 0.5rem;
    background: rgba(0, 0, 0, 0.08);
    cursor: pointer;
    font-size: 1.4rem;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  .fullscreen-button:hover {
    opacity: 1;
  }

  .pdf-button {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1000;
    padding: 0.6rem 1rem;
    border: none;
    border-radius: 0.5rem;
    background: rgba(0, 0, 0, 0.08);
    cursor: pointer;
  }

  .presentation-container.presentation-mode {
    width: 100vw;
    height: 100vh;
    background: white;
  }

  .presentation-mode .slides {
    width: 100%;
    height: 100%;
  }

  .slide-counter {
    display: none;
  }

  .presentation-mode .slide-counter {
    display: block;
    position: fixed;
    right: 2rem;
    bottom: 1.5rem;
    z-index: 1000;
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.5;
    letter-spacing: 0.05em;
  }

  .presentation-mode .fullscreen-button,
  .presentation-mode .pdf-button {
    display: none;
  }

  .print-slide-counter {
    display: none;
  }
</style>
