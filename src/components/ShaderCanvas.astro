---
/**
 * ShaderCanvas : affiche un shader GLSL local avec Three.js.
 * Le composant remplit 100 % du div parent (qui doit donc avoir une hauteur).
 *
 * Les shaders vivent dans src/shaders/ (.frag, .vert, .glsl) et sont lus au build :
 *   <ShaderCanvas shader="plasma.frag" />
 *
 * mode="image" (défaut) : quad plein écran, fragment shader au format Shadertoy
 *   (mainImage + iTime, iResolution, iMouse, iFrame, iTimeDelta) ou void main() classique.
 * mode="mesh" : géométrie 3D (sphere, torus, box, plane) avec caméra orbitale.
 *   Le vertex shader par défaut fournit vUv, vNormal (espace vue), vPosition et vColor.
 *   Avec mesh="mon.ply" (fichier dans src/meshes/), le maillage (triangles uniquement) est
 *   chargé, centré et normalisé dans la sphère unité ; le mode passe automatiquement à "mesh".
 *   Avec mesh={["a.ply", "b.ply", ...]}, la séquence est lue en aller-retour à `fps` images/s.
 *   Toutes les frames subissent la même transformation : le mouvement entre frames est conservé.
 *   vColor vaut les couleurs des sommets du PLY s'il y en a, sinon vec3(1.0).
 *
 * Les uniforms iResolution, iTime, iTimeDelta, iFrame, iMouse sont déclarés
 * automatiquement : ne pas les redéclarer dans les shaders.
 */
interface Props {
  /** Chemin du fragment shader relatif à src/shaders/ */
  shader: string;
  /** Vertex shader optionnel (mode mesh uniquement), relatif à src/shaders/ */
  vertex?: string;
  mode?: 'image' | 'mesh';
  geometry?: 'sphere' | 'torus' | 'box' | 'plane';
  /** Maillage PLY (triangles) relatif à src/meshes/, ou séquence de PLY lue en aller-retour (remplace `geometry`) */
  mesh?: string | string[];
  /** Images par seconde pour une séquence de maillages */
  fps?: number;
  /** Facteur de recul de la caméra initiale (mode mesh) */
  initialZoom?: number;
  /** OrbitControls (mode mesh). Actifs par défaut en mesh. */
  controls?: boolean;
  /** Force le rendu continu (true) ou à la demande (false). Par défaut : auto-détecté (iTime/iFrame utilisés). */
  animated?: boolean;
  /** Bouton plein écran */
  fullscreen?: boolean;
  /** Plafond du devicePixelRatio, pour limiter le coût GPU */
  maxPixelRatio?: number;
  class?: string;
}

const {
  shader,
  vertex,
  mesh,
  mode = mesh ? 'mesh' : 'image',
  geometry = 'sphere',
  controls = mode === 'mesh',
  animated,
  fullscreen = true,
  maxPixelRatio = 2,
  fps = 10,
  initialZoom = 1.15,
  class: className = '',
} = Astro.props;

const modules = import.meta.glob('/src/shaders/**/*.{glsl,frag,vert}', {
  query: '?raw',
  import: 'default',
}) as Record<string, () => Promise<string>>;

async function load(name: string): Promise<string> {
  const loader = modules[`/src/shaders/${name}`];
  if (!loader) throw new Error(`[ShaderCanvas] Shader introuvable : src/shaders/${name}`);
  return loader();
}

const meshModules = import.meta.glob('/src/meshes/**/*.ply', {
  query: '?url',
  import: 'default',
}) as Record<string, () => Promise<string>>;

const frag = await load(shader);
const vert = vertex ? await load(vertex) : null;

// Les maillages ne sont pas embarqués dans le HTML (trop lourds) : on passe leurs URLs, chargées côté client.
const meshNames = mesh ? (Array.isArray(mesh) ? mesh : [mesh]) : [];
const meshUrls: string[] = await Promise.all(
  meshNames.map(async (name) => {
    const loader = meshModules[`/src/meshes/${name}`];
    if (!loader) throw new Error(`[ShaderCanvas] Maillage introuvable : src/meshes/${name}`);
    return loader();
  })
);

// Les shaders sont embarqués dans le HTML : pas de fetch côté client.
const config = JSON.stringify({
  frag,
  vert,
  mode,
  geometry,
  meshUrls,
  fps,
  initialZoom,
  controls,
  animated: animated ?? null,
  maxPixelRatio,
}).replace(/</g, '\\u003c');
---

<div class:list={['shader-canvas', className]} data-shader-canvas>
  <div class="sc-view"></div>
  {meshUrls.length > 0 && <div class="sc-loading">Chargement du modèle…</div>}
  {
    fullscreen && (
      <button type="button" class="sc-fs" aria-label="Plein écran" title="Plein écran">
        ⛶
      </button>
    )
  }
  <pre class="sc-error" hidden></pre>
  <script is:inline type="application/json" class="sc-config" set:html={config} />
</div>

<style>
  .shader-canvas {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
  }
  .sc-view {
    position: absolute;
    inset: 0;
  }
  .shader-canvas:fullscreen {
    width: 100vw;
    height: 100vh;
  }
  .sc-fs {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.5rem;
    font-size: 1.1rem;
    line-height: 1;
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .shader-canvas:hover .sc-fs,
  .sc-fs:focus-visible {
    opacity: 1;
  }
  @media (hover: none) {
    .sc-fs {
      opacity: 0.8;
    }
  }
  .sc-error {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 1rem;
    overflow: auto;
    color: #ff8080;
    background: rgba(0, 0, 0, 0.88);
    font: 12px/1.4 monospace;
    white-space: pre-wrap;
  }
  .sc-loading {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 0.85rem;
    background: rgb(0 0 0 / 30%);
    pointer-events: none;
  }
</style>

<script>
  import {
    WebGLRenderer,
    Scene,
    OrthographicCamera,
    PerspectiveCamera,
    PlaneGeometry,
    SphereGeometry,
    TorusGeometry,
    BoxGeometry,
    ShaderMaterial,
    Mesh,
    Vector2,
    Vector3,
    Vector4,
    Box3,
    type BufferGeometry,
  } from 'three';

  const PRELUDE = `uniform vec3 iResolution;
uniform float iTime;
uniform float iTimeDelta;
uniform int iFrame;
uniform vec4 iMouse;
`;

  const QUAD_VERT = `void main() { gl_Position = vec4(position.xy, 0.0, 1.0); }`;

  const MESH_VERT = `varying vec2 vUv;
varying vec3 vNormal;
varying vec3 vPosition;
varying vec3 vColor;
void main() {
  vUv = uv;
  vNormal = normalize(normalMatrix * normal);
  vPosition = position;
#ifdef USE_COLOR
  vColor = color;
#else
  vColor = vec3(1.0);
#endif
  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
}`;

  const IMAGE_MAIN = `
void main() {
  vec4 c = vec4(0.0, 0.0, 0.0, 1.0);
  mainImage(c, gl_FragCoord.xy);
  gl_FragColor = c;
}`;

  const GEOMETRIES: Record<string, () => BufferGeometry> = {
    sphere: () => new SphereGeometry(1, 64, 64),
    torus: () => new TorusGeometry(0.7, 0.3, 48, 128),
    box: () => new BoxGeometry(1.4, 1.4, 1.4, 32, 32, 32),
    plane: () => new PlaneGeometry(2, 2, 64, 64),
  };

  // Charge une ou plusieurs frames PLY (triangles). Toutes subissent la même transformation :
  // centrées sur la boîte englobante globale puis normalisées dans la sphère unité,
  // pour que le mouvement entre frames soit conservé.
  async function loadPlySequence(urls: string[]): Promise<BufferGeometry[]> {
    const { PLYLoader } = await import('three/examples/jsm/loaders/PLYLoader.js');
    const loader = new PLYLoader();
    const geos = await Promise.all(urls.map((u) => loader.loadAsync(u)));

    const box = new Box3();
    for (const g of geos) {
      if (!g.getAttribute('normal')) g.computeVertexNormals();
      g.computeBoundingBox();
      box.union(g.boundingBox!);
    }
    const c = box.getCenter(new Vector3());

    let r2 = 0;
    for (const g of geos) {
      g.translate(-c.x, -c.y, -c.z);
      const p = g.getAttribute('position');
      for (let i = 0; i < p.count; i++) {
        r2 = Math.max(r2, p.getX(i) ** 2 + p.getY(i) ** 2 + p.getZ(i) ** 2);
      }
    }
    const s = r2 > 0 ? 1 / Math.sqrt(r2) : 1;
    geos.forEach((g) => g.scale(s, s, s));
    return geos;
  }

  const cleanups = new Set<() => void>();

  async function mount(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    const cfg = JSON.parse(root.querySelector('.sc-config')!.textContent || '{}');
    const view = root.querySelector<HTMLElement>('.sc-view')!;
    const errBox = root.querySelector<HTMLElement>('.sc-error')!;
    const fsBtn = root.querySelector<HTMLButtonElement>('.sc-fs');

    const fail = (msg: string) => {
      errBox.textContent = msg;
      errBox.hidden = false;
      console.error('[ShaderCanvas]', msg);
    };

    let plyGeometries: BufferGeometry[] = [];
    if (cfg.mode === 'mesh' && cfg.meshUrls?.length) {
      try {
        plyGeometries = await loadPlySequence(cfg.meshUrls);
      } catch (e) {
        root.querySelector('.sc-loading')?.remove();
        fail(`Impossible de charger le maillage PLY : ${e instanceof Error ? e.message : e}`);
        return;
      }
      root.querySelector('.sc-loading')?.remove();
      if (!root.isConnected) {
        plyGeometries.forEach((g) => g.dispose());
        return;
      }
    }

    let renderer: WebGLRenderer;
    try {
      renderer = new WebGLRenderer({
        antialias: cfg.mode === 'mesh',
        powerPreference: 'high-performance',
      });
    } catch {
      fail('WebGL est indisponible sur ce navigateur.');
      return;
    }

    const canvas = renderer.domElement;
    canvas.style.cssText = 'display:block;width:100%;height:100%';
    view.appendChild(canvas);

    const isMesh = cfg.mode === 'mesh';
    const allSrc: string = cfg.frag + (cfg.vert ?? '');
    const usesTime = /\b(iTime|iTimeDelta|iFrame)\b/.test(allSrc);
    const usesMouse = /\biMouse\b/.test(allSrc);
    const frameCount: number = cfg.meshUrls?.length ?? 0;
    const animated: boolean = cfg.animated ?? (usesTime || frameCount > 1);

    const uniforms = {
      iResolution: { value: new Vector3(1, 1, 1) },
      iTime: { value: 0 },
      iTimeDelta: { value: 0 },
      iFrame: { value: 0 },
      iMouse: { value: new Vector4(0, 0, 0, 0) },
    };

    const hasMain = /void\s+main\s*\(/.test(cfg.frag);
    const material = new ShaderMaterial({
      uniforms,
      vertexColors: !!plyGeometries[0]?.getAttribute('color'),
      vertexShader: PRELUDE + (isMesh ? (cfg.vert ?? MESH_VERT) : QUAD_VERT),
      fragmentShader: PRELUDE + cfg.frag + (hasMain ? '' : IMAGE_MAIN),
    });

    // Les numéros de ligne du log sont décalés par le prélude et le préambule de Three.
    renderer.debug.onShaderError = (gl, _program, vs, fs) => {
      const log =
        gl.getShaderInfoLog(fs) || gl.getShaderInfoLog(vs) || 'Erreur de compilation du shader.';
      console.error('[ShaderCanvas]', log);
      if (import.meta.env.DEV) fail(log);
    };

    const scene = new Scene();
    let camera: PerspectiveCamera | OrthographicCamera;
    let geometries: BufferGeometry[];
    if (isMesh) {
      camera = new PerspectiveCamera(45, 1, 0.1, 100);
      camera.position.set(0, 0, 3.2);
      geometries = plyGeometries.length
        ? plyGeometries
        : [(GEOMETRIES[cfg.geometry] ?? GEOMETRIES.sphere)()];
    } else {
      camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);
      geometries = [new PlaneGeometry(2, 2)];
    }
    const mesh = new Mesh(geometries[0], material);
    mesh.frustumCulled = false;
    scene.add(mesh);

    // --- Boucle de rendu : continue si animé, sinon à la demande ---
    let controls: any = null;
    let visible = true;
    let disposed = false;
    let raf = 0;
    let last = performance.now();
    let time = 0;
    let frame = 0;

    // Lecture de séquence en aller-retour (comme PlyVideo)
    let seqIndex = 0;
    let seqDir = 1;
    let seqAcc = 0;
    const seqStep = 1 / (cfg.fps > 0 ? cfg.fps : 10);

    const render = () => {
      const now = performance.now();
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      time += dt;
      if (geometries.length > 1) {
        seqAcc += dt;
        let changed = false;
        while (seqAcc >= seqStep) {
          seqAcc -= seqStep;
          seqIndex += seqDir;
          if (seqIndex >= geometries.length - 1) {
            seqIndex = geometries.length - 1;
            seqDir = -1;
          } else if (seqIndex <= 0) {
            seqIndex = 0;
            seqDir = 1;
          }
          changed = true;
        }
        if (changed) mesh.geometry = geometries[seqIndex];
      }
      uniforms.iTime.value = time;
      uniforms.iTimeDelta.value = dt;
      uniforms.iFrame.value = frame++;
      controls?.update();
      renderer.render(scene, camera);
    };

    const tick = () => {
      raf = 0;
      if (disposed || !visible) return;
      render();
      if (animated && !raf) raf = requestAnimationFrame(tick);
    };

    const requestRender = () => {
      if (!raf && visible && !disposed) raf = requestAnimationFrame(tick);
    };

    // --- Taille : suit le div parent ---
    const size = new Vector2();
    let fitted = false;
    const resize = () => {
      const w = Math.max(1, view.clientWidth);
      const h = Math.max(1, view.clientHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, cfg.maxPixelRatio));
      renderer.setSize(w, h, false);
      renderer.getDrawingBufferSize(size);
      uniforms.iResolution.value.set(size.x, size.y, 1);
      if (camera instanceof PerspectiveCamera) {
        camera.aspect = w / h;
        // Cadrage initial (une seule fois) : le maillage est dans la sphère unité
        if (!fitted && view.clientWidth > 0 && view.clientHeight > 0) {
          fitted = true;
          const vf = (camera.fov * Math.PI) / 180;
          const hf = 2 * Math.atan(Math.tan(vf / 2) * camera.aspect);
          const d = Math.max(1 / Math.sin(vf / 2), 1 / Math.sin(hf / 2)) * cfg.initialZoom;
          camera.position.set(0, 0, d);
          camera.near = d / 100;
          camera.far = d * 100;
          controls?.update();
        }
        camera.updateProjectionMatrix();
      }
      requestRender();
    };
    const ro = new ResizeObserver(resize);
    ro.observe(view);

    // --- Pause hors de l'écran ---
    const io = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) {
        last = performance.now();
        requestRender();
      }
    });
    io.observe(root);

    // --- Contrôles orbitaux (mode mesh) ---
    if (isMesh && cfg.controls) {
      const { OrbitControls } = await import('three/examples/jsm/controls/OrbitControls.js');
      if (disposed) return;
      controls = new OrbitControls(camera, canvas);
      controls.enableDamping = animated;
      controls.enablePan = false;
      controls.addEventListener('change', requestRender);
      canvas.style.touchAction = 'none';
    }

    // --- iMouse au format Shadertoy (pixels du drawing buffer, y vers le haut) ---
    if (usesMouse) {
      canvas.style.touchAction = 'none';
      const m = uniforms.iMouse.value;
      let down = false;
      const pos = (e: PointerEvent): [number, number] => {
        const r = canvas.getBoundingClientRect();
        renderer.getDrawingBufferSize(size);
        return [
          ((e.clientX - r.left) * size.x) / r.width,
          size.y - ((e.clientY - r.top) * size.y) / r.height,
        ];
      };
      canvas.addEventListener('pointerdown', (e) => {
        const [x, y] = pos(e);
        down = true;
        m.set(x, y, x, y);
        canvas.setPointerCapture(e.pointerId);
        requestRender();
      });
      canvas.addEventListener('pointermove', (e) => {
        if (!down) return;
        const [x, y] = pos(e);
        m.x = x;
        m.y = y;
        requestRender();
      });
      const up = () => {
        if (!down) return;
        down = false;
        m.z = -Math.abs(m.z);
        m.w = -Math.abs(m.w);
        requestRender();
      };
      canvas.addEventListener('pointerup', up);
      canvas.addEventListener('pointercancel', up);
    }

    // --- Plein écran ---
    if (fsBtn) {
      if (!document.fullscreenEnabled) fsBtn.hidden = true;
      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement === root) document.exitFullscreen();
        else root.requestFullscreen?.();
      });
    }

    cleanups.add(() => {
      disposed = true;
      cancelAnimationFrame(raf);
      ro.disconnect();
      io.disconnect();
      controls?.dispose();
      geometries.forEach((g) => g.dispose());
      material.dispose();
      renderer.dispose();
      renderer.forceContextLoss();
      canvas.remove();
      delete root.dataset.ready;
    });

    requestRender();
  }

  const initAll = () =>
    document.querySelectorAll<HTMLElement>('[data-shader-canvas]').forEach((el) => mount(el));

  initAll();

  // Compatibilité avec le routeur de transitions d'Astro (<ClientRouter />)
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((c) => c());
    cleanups.clear();
  });
  document.addEventListener('astro:after-swap', initAll);
</script>
