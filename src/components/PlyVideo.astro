---
interface Props {
  srcs: string[];
  fps?: number;
  pointSize?: number;
  color?: string;
  backgroundColor?: string;
  autoRotate?: boolean;
  shading?: "matcap" | "standard";
  flatShading?: boolean;
  initialZoom?: number;
}

const {
  srcs,
  fps = 10,
  pointSize = 0.01,
  color = "#d0d0d0",
  backgroundColor = "transparent",
  autoRotate = false,
  shading = "matcap",
  flatShading = false,
  initialZoom = 1.15,
} = Astro.props;
---

<div
  class="ply-video"
  data-srcs={JSON.stringify(srcs)}
  data-fps={fps}
  data-point-size={pointSize}
  data-color={color}
  data-auto-rotate={autoRotate ? "true" : "false"}
  data-shading={shading}
  data-flat-shading={flatShading ? "true" : "false"}
  style={`--ply-video-bg: ${backgroundColor};`}
  data-initial-zoom={initialZoom}
>
  <div class="ply-video-canvas-wrapper"></div>

  <div class="ply-video-loading">
    Chargement du modèle…
  </div>
</div>

<script>
  import * as THREE from "three";
  import { PLYLoader } from "three/addons/loaders/PLYLoader.js";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";


  /*
   * ============================================================
   * INITIALISATION
   * ============================================================
   */

  function initPlyVideos() {

    const videos =
      document.querySelectorAll(
        ".ply-video:not([data-ply-video-initialized])"
      );


    videos.forEach((video) => {

      video.dataset.plyVideoInitialized =
        "true";


      const wrapper =
        video.querySelector(
          ".ply-video-canvas-wrapper"
        );


      const loadingEl =
        video.querySelector(
          ".ply-video-loading"
        );


      if (!wrapper) {
        return;
      }


      /*
       * ========================================================
       * PROPRIÉTÉS
       * ========================================================
       */

      let srcs;

      try {

        srcs = JSON.parse(
          video.dataset.srcs || "[]"
        );

      } catch (error) {

        console.error(
          "PLY VIDEO: INVALID SOURCE DATA",
          error
        );

        return;
      }


      if (
        !Array.isArray(srcs) ||
        srcs.length === 0
      ) {

        console.error(
          "PLY VIDEO: NO PLY SOURCES"
        );

        return;
      }


      const fps =
        Number(video.dataset.fps) || 10;


      const pointSize =
        Number(video.dataset.pointSize) || 0.01;


      const baseColor =
        video.dataset.color || "#d0d0d0";


      const autoRotate =
        video.dataset.autoRotate === "true";


      const shading =
        video.dataset.shading || "matcap";


      const flatShading =
        video.dataset.flatShading === "true";
        const initialZoom =
  Number(video.dataset.initialZoom) || 1.15;


      /*
       * ========================================================
       * STEREOGRAM
       * ========================================================
       */

      const stereogram =
        video.closest(".stereogram");


      const isStereo =
        !!stereogram;


      const stereoAngle =
        THREE.MathUtils.degToRad(
          Number(
            stereogram?.dataset.stereoAngle
          ) || 3
        );


      /*
       * ========================================================
       * SCENE
       * ========================================================
       */

      const scene =
        new THREE.Scene();


      /*
       * ========================================================
       * CAMERA
       * ========================================================
       */

      const camera =
        new THREE.PerspectiveCamera(
          45,
          1,
          0.01,
          100
        );


      camera.position.set(
        0,
        0,
        3
      );


      /*
       * ========================================================
       * RENDERER
       * ========================================================
       */

      const renderer =
        new THREE.WebGLRenderer({
          antialias: true,
          alpha: true,
        });


      renderer.setClearColor(
        0x000000,
        0
      );


      renderer.setPixelRatio(
        Math.min(
          window.devicePixelRatio,
          2
        )
      );


      renderer.domElement.style.width =
        "100%";


      renderer.domElement.style.height =
        "100%";


      renderer.domElement.style.display =
        "block";


      wrapper.appendChild(
        renderer.domElement
      );


      /*
       * ========================================================
       * CONTROLS
       * ========================================================
       */

      const controls =
        new OrbitControls(
          camera,
          renderer.domElement
        );


      controls.enableDamping =
        true;


      controls.dampingFactor =
        0.08;


      controls.autoRotate =
        autoRotate;


      controls.autoRotateSpeed =
        2;


      controls.minDistance =
        0.05;


      controls.maxDistance =
        50;


      /*
       * ========================================================
       * LUMIÈRES
       * ========================================================
       */

      scene.add(
        new THREE.HemisphereLight(
          0xffffff,
          0x444455,
          0.5
        )
      );


      const keyLight =
        new THREE.DirectionalLight(
          0xffffff,
          1.1
        );


      keyLight.position.set(
        3,
        4,
        5
      );


      scene.add(keyLight);


      const fillLight =
        new THREE.DirectionalLight(
          0xffffff,
          0.35
        );


      fillLight.position.set(
        -4,
        1,
        2
      );


      scene.add(fillLight);


      const rimLight =
        new THREE.DirectionalLight(
          0xffffff,
          0.5
        );


      rimLight.position.set(
        -1,
        3,
        -4
      );


      scene.add(rimLight);


      /*
       * ========================================================
       * MATCAP
       * ========================================================
       */

      function createClayMatcap() {

        const size = 256;

        const canvas =
          document.createElement("canvas");

        canvas.width = size;
        canvas.height = size;

        const ctx =
          canvas.getContext("2d");

        if (!ctx) {
          return null;
        }

        const gradient =
          ctx.createRadialGradient(
            size * 0.35,
            size * 0.35,
            size * 0.05,
            size * 0.5,
            size * 0.5,
            size * 0.7
          );


        gradient.addColorStop(
          0,
          "#ffffff"
        );

        gradient.addColorStop(
          0.35,
          "#eeeeee"
        );

        gradient.addColorStop(
          0.65,
          "#d0d0d0"
        );

        gradient.addColorStop(
          0.85,
          "#aaaaaa"
        );

        gradient.addColorStop(
          1,
          "#858585"
        );


        ctx.fillStyle =
          gradient;

        ctx.fillRect(
          0,
          0,
          size,
          size
        );


        const texture =
          new THREE.CanvasTexture(
            canvas
          );


        texture.colorSpace =
          THREE.SRGBColorSpace;


        return texture;
      }


      const clayMatcap =
        createClayMatcap();


      /*
       * ========================================================
       * FRAMES
       * ========================================================
       */

      const frames = [];


      /*
       * ========================================================
       * MATÉRIAU
       * ========================================================
       */

      function createMaterial(
        geometry
      ) {

        const hasColors =
          !!geometry.getAttribute(
            "color"
          );


        if (
          shading === "matcap" &&
          clayMatcap
        ) {

          return new THREE.MeshMatcapMaterial({

            color:
              hasColors
                ? 0xffffff
                : baseColor,

            vertexColors:
              hasColors,

            matcap:
              clayMatcap,

            flatShading,

            side:
              THREE.DoubleSide,
          });
        }


        return new THREE.MeshStandardMaterial({

          color:
            hasColors
              ? 0xffffff
              : baseColor,

          vertexColors:
            hasColors,

          flatShading,

          side:
            THREE.DoubleSide,
        });
      }


      /*
       * ========================================================
       * OBJET
       * ========================================================
       */

      function createObject(
        geometry
      ) {

        geometry.computeVertexNormals();


        const hasFaces =
          geometry.index !== null &&
          geometry.index.count > 0;


        const hasColors =
          !!geometry.getAttribute(
            "color"
          );


        if (hasFaces) {

          const material =
            createMaterial(
              geometry
            );


          return new THREE.Mesh(
            geometry,
            material
          );
        }


        const material =
          new THREE.PointsMaterial({

            size:
              pointSize,

            color:
              hasColors
                ? 0xffffff
                : baseColor,

            vertexColors:
              hasColors,

            sizeAttenuation:
              true,
          });


        return new THREE.Points(
          geometry,
          material
        );
      }


      /*
       * ========================================================
       * CHARGEMENT
       * ========================================================
       */

      const loader =
        new PLYLoader();


      function loadFrame(src) {

        return new Promise(
          function (
            resolve,
            reject
          ) {

            loader.load(

              src,

              function (
                geometry
              ) {

                const object =
                  createObject(
                    geometry
                  );


                const box =
                  new THREE.Box3()
                    .setFromObject(
                      object
                    );


                const center =
                  box.getCenter(
                    new THREE.Vector3()
                  );


                object.position.sub(
                  center
                );


                object.visible =
                  false;


                scene.add(
                  object
                );


                resolve(object);
              },

              undefined,

              function (
                error
              ) {

                console.error(
                  "PLY VIDEO: LOAD ERROR",
                  src,
                  error
                );


                reject(error);
              }
            );
          }
        );
      }


      /*
       * ========================================================
       * CADRAGE
       * ========================================================
       */

      function fitCamera() {

        if (
          frames.length === 0
        ) {
          return;
        }


        const globalBox =
          new THREE.Box3();


        frames.forEach(
          function (
            object
          ) {

            const box =
              new THREE.Box3()
                .setFromObject(
                  object
                );


            globalBox.union(
              box
            );
          }
        );


        const sphere =
          globalBox.getBoundingSphere(
            new THREE.Sphere()
          );


        const radius =
          sphere.radius || 1;


        let aspect;


        if (isStereo) {

          const width =
            wrapper.clientWidth;

          const height =
            wrapper.clientHeight;

          aspect =
            (width / 2) / height;

        } else {

          aspect =
            wrapper.clientWidth /
            wrapper.clientHeight;
        }


        const verticalFov =
          THREE.MathUtils.degToRad(
            camera.fov
          );


        const horizontalFov =
          2 *
          Math.atan(
            Math.tan(verticalFov / 2) *
            aspect
          );


        const verticalDistance =
          radius /
          Math.sin(
            verticalFov / 2
          );


        const horizontalDistance =
          radius /
          Math.sin(
            horizontalFov / 2
          );


        const distance =
  Math.max(
    verticalDistance,
    horizontalDistance
  ) * initialZoom;


        camera.position.set(
          0,
          0,
          distance
        );


        camera.near =
          distance / 100;


        camera.far =
          distance * 100;


        camera.updateProjectionMatrix();


        controls.target.set(
          0,
          0,
          0
        );


        controls.update();
      }


      /*
       * ========================================================
       * AFFICHAGE
       * ========================================================
       */

      function showFrame(index) {

        frames.forEach(
          function (
            object,
            i
          ) {

            object.visible =
              i === index;
          }
        );
      }


      /*
       * ========================================================
       * CHARGEMENT
       * ========================================================
       */

      async function loadAllFrames() {

        try {

          const loaded =
            await Promise.all(
              srcs.map(
                function (
                  src
                ) {

                  return loadFrame(
                    src
                  );
                }
              )
            );


          frames.push(
            ...loaded
          );


          if (
            frames.length === 0
          ) {

            throw new Error(
              "Aucune frame chargée"
            );
          }


          showFrame(0);

          fitCamera();


          if (loadingEl) {
            loadingEl.remove();
          }


          /*
           * ======================================================
           * API POUR LES AUTOSTÉRÉOGRAMMES
           * ======================================================
           */

          video.__plyVideoAPI = {

            scene,

            camera,

            controls,

            renderer,

            frames,

            getCurrentObject() {

              if (
                frameIndex < 0 ||
                frameIndex >= frames.length
              ) {
                return null;
              }

              return frames[
                frameIndex
              ];
            },

            getCurrentFrame() {

              return frameIndex;
            },

            getIsStereo() {

              return isStereo;
            },
          };


          video.dispatchEvent(
            new CustomEvent(
              "ply-video-ready"
            )
          );


          startAnimation();


        } catch (error) {

          console.error(
            "PLY VIDEO: LOADING FAILED",
            error
          );


          if (loadingEl) {

            loadingEl.textContent =
              "Erreur de chargement des modèles";
          }
        }
      }


      /*
       * ========================================================
       * ANIMATION
       * ========================================================
       */

      let frameIndex = 0;

      let direction = 1;

      let lastFrameTime =
        performance.now();


      const frameDuration =
        1000 / fps;


      function updateAnimation(
        currentTime
      ) {

        const elapsed =
          currentTime -
          lastFrameTime;


        if (
          elapsed >=
          frameDuration
        ) {

          lastFrameTime +=
            frameDuration;


          frameIndex +=
            direction;


          if (
            frameIndex >=
            frames.length - 1
          ) {

            frameIndex =
              frames.length - 1;

            direction =
              -1;

          } else if (
            frameIndex <= 0
          ) {

            frameIndex =
              0;

            direction =
              1;
          }


          showFrame(
            frameIndex
          );


          video.dispatchEvent(
            new CustomEvent(
              "ply-video-frame"
            )
          );
        }
      }


      /*
       * ========================================================
       * CAMÉRAS STÉRÉO
       * ========================================================
       */

      const leftCamera =
        new THREE.PerspectiveCamera(
          45,
          1,
          0.01,
          100
        );


      const rightCamera =
        new THREE.PerspectiveCamera(
          45,
          1,
          0.01,
          100
        );


      function updateStereoCameras() {

        if (!isStereo) {
          return;
        }


        const position =
          camera.position.clone();


        const target =
          controls.target.clone();


        const view =
          target.clone().sub(
            position
          );


        const leftView =
          view.clone().applyAxisAngle(
            new THREE.Vector3(
              0,
              1,
              0
            ),
            -stereoAngle
          );


        const rightView =
          view.clone().applyAxisAngle(
            new THREE.Vector3(
              0,
              1,
              0
            ),
            stereoAngle
          );


        leftCamera.position.copy(
          position
        );


        rightCamera.position.copy(
          position
        );


        leftCamera.lookAt(
          position.clone().add(
            leftView
          )
        );


        rightCamera.lookAt(
          position.clone().add(
            rightView
          )
        );


        leftCamera.fov =
          camera.fov;

        rightCamera.fov =
          camera.fov;


        leftCamera.near =
          camera.near;

        rightCamera.near =
          camera.near;


        leftCamera.far =
          camera.far;

        rightCamera.far =
          camera.far;


        leftCamera.updateProjectionMatrix();

        rightCamera.updateProjectionMatrix();
      }


      /*
       * ========================================================
       * RESIZE
       * ========================================================
       */

      function resize() {

        const width =
          wrapper.clientWidth;


        const height =
          wrapper.clientHeight;


        if (
          !width ||
          !height
        ) {
          return;
        }


        renderer.setSize(
          width,
          height,
          false
        );


        if (!isStereo) {

          camera.aspect =
            width / height;

          camera.updateProjectionMatrix();

          return;
        }


        const eyeWidth =
          width / 2;


        const aspect =
          eyeWidth / height;


        leftCamera.aspect =
          aspect;

        rightCamera.aspect =
          aspect;


        leftCamera.updateProjectionMatrix();

        rightCamera.updateProjectionMatrix();
      }


      /*
       * ========================================================
       * RENDU
       * ========================================================
       */

      let frameId = null;


      function animate(currentTime) {

        updateAnimation(
          currentTime
        );


        controls.update();


        const width =
          wrapper.clientWidth;


        const height =
          wrapper.clientHeight;


        if (
          !width ||
          !height
        ) {

          frameId =
            requestAnimationFrame(
              animate
            );

          return;
        }


        if (isStereo) {

          updateStereoCameras();


          const halfWidth =
            width / 2;


          renderer.setScissorTest(
            true
          );


          renderer.setViewport(
            0,
            0,
            halfWidth,
            height
          );


          renderer.setScissor(
            0,
            0,
            halfWidth,
            height
          );


          renderer.render(
            scene,
            leftCamera
          );


          renderer.setViewport(
            halfWidth,
            0,
            halfWidth,
            height
          );


          renderer.setScissor(
            halfWidth,
            0,
            halfWidth,
            height
          );


          renderer.render(
            scene,
            rightCamera
          );


          renderer.setScissorTest(
            false
          );


        } else {

          renderer.setViewport(
            0,
            0,
            width,
            height
          );


          renderer.render(
            scene,
            camera
          );
        }


        frameId =
          requestAnimationFrame(
            animate
          );
      }


      function startAnimation() {

        lastFrameTime =
          performance.now();


        if (
          frameId === null
        ) {

          frameId =
            requestAnimationFrame(
              animate
            );
        }
      }


      /*
       * ========================================================
       * RESIZE OBSERVER
       * ========================================================
       */

      const resizeObserver =
        new ResizeObserver(
          resize
        );


      resizeObserver.observe(
        wrapper
      );


      resize();


      /*
       * ========================================================
       * START
       * ========================================================
       */

      loadAllFrames();


      /*
       * ========================================================
       * CLEANUP
       * ========================================================
       */

      const cleanupObserver =
        new MutationObserver(
          function () {

            if (
              !document.body.contains(
                video
              )
            ) {

              if (
                frameId !== null
              ) {

                cancelAnimationFrame(
                  frameId
                );
              }


              resizeObserver.disconnect();


              controls.dispose();


              frames.forEach(
                function (
                  object
                ) {

                  scene.remove(
                    object
                  );


                  object.geometry.dispose();


                  if (
                    object.material
                  ) {

                    object.material.dispose();
                  }
                }
              );


              renderer.dispose();


              if (
                clayMatcap
              ) {

                clayMatcap.dispose();
              }


              cleanupObserver.disconnect();
            }
          }
        );


      cleanupObserver.observe(
        document.body,
        {
          childList: true,
          subtree: true,
        }
      );
    });
  }


  initPlyVideos();


  document.addEventListener(
    "astro:page-load",
    initPlyVideos
  );
</script>

<style>
  .ply-video {
    position: relative;

    width: 100%;

    aspect-ratio: 16 / 9;

    border-radius: 12px;

    overflow: hidden;

    background:
      var(--ply-video-bg, transparent);

    user-select: none;
  }


  .ply-video-canvas-wrapper {
    position: relative;

    width: 100%;
    height: 100%;
  }


  .ply-video-canvas-wrapper canvas {
    display: block;

    width: 100% !important;
    height: 100% !important;

    cursor: grab;
  }


  .ply-video-canvas-wrapper canvas:active {
    cursor: grabbing;
  }


  .ply-video-loading {
    position: absolute;

    inset: 0;

    z-index: 10;

    display: flex;

    align-items: center;
    justify-content: center;

    color: white;

    font-size: 0.85rem;

    background:
      rgb(0 0 0 / 30%);

    pointer-events: none;
  }
</style>
