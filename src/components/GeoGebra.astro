---
interface Props {
  id: string;
  width?: string;
  height?: string;
}

const {
  id,
  width = "100%",
  height = "500px",
} = Astro.props;
---

<div class="geogebra-container">
  <iframe
    src={`https://www.geogebra.org/material/iframe/id/${id}/width/1700/height/1000/ai/false/smb/false/stb/false/sri/false/rc/false`}
    width={width}
    height={height}
    style="border: 0;"
    allowfullscreen
  ></iframe>
</div>

<style>
  .geogebra-container {
    width: 100%;
    display: flex;
  }

  iframe {
    display: block;
  }
  
</style>
