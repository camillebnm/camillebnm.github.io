float sdSegment(vec2 p, vec2 a, vec2 b)
{
    vec2 pa = p - a;
    vec2 ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-12), 0.0, 1.0);
    return length(pa - ba * h);
}

// SDF du polygone
float polygonSDF(vec2 p, vec2 vertices[N])
{
    float d = 1e10;
    bool inside = false;

    for (int i = 0; i < N; i++)
    {
        vec2 a = vertices[i];
        vec2 b = vertices[(i + 1) % N];

        d = min(d, sdSegment(p, a, b));

        if ((a.y > p.y) != (b.y > p.y) &&
            p.x < (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x)
            inside = !inside;
    }

    return inside ? -d : d;
}

void accumulatePolygon(
    vec2 p, vec2 a, vec2 b,
    inout float minD2,
    inout bool inside
)
{
    vec2 pa = p - a;
    vec2 ba = b - a;

    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-12), 0.0, 1.0);
    vec2 q = pa - ba * h;

    minD2 = min(minD2, dot(q, q));

    if ((a.y > p.y) != (b.y > p.y) &&
        p.x < (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x)
        inside = !inside;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord)
{
    vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;
    vec2 p = uv * 0.5 + 0.5;

    float t = 0.5 - 0.5 * cos(iTime);

    float minDP2 = 1e10;
    float minDM2 = 1e10;
    bool insideP = false;
    bool insideM = false;

    // Une seule boucle pour les deux polygones
    for (int i = 0; i < N; i++)
    {
        int j = (i + 1 == N) ? 0 : i + 1;

        accumulatePolygon(p, P[i], P[j], minDP2, insideP);
        accumulatePolygon(p, M[i], M[j], minDM2, insideM);
    }

    float dP = sqrt(minDP2) * (insideP ? -1.0 : 1.0);
    float dM = sqrt(minDM2) * (insideM ? -1.0 : 1.0);

    float d = mix(dP, dM, t);

    // Normalisation du gradient par dérivées GPU
    float grad = length(vec2(dFdx(d), dFdy(d))) * iResolution.y;
    d /= max(grad, 1e-4);

    float aa = 1.0 / iResolution.y;
    float line = 1.0 - smoothstep(aa, 2.0 * aa, abs(d));

    vec3 bg = vec3(1.0);
    vec3 fg = vec3(0.95, 0.35, 0.25);

    fragColor = vec4(mix(bg, fg, line), 1.0);
}
