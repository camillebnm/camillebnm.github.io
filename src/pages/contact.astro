---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact">
  <h1>Contact</h1>

  <section class="contact-links">

    <!-- GitHub -->
    <a
      class="contact-card"
      href="https://github.com/camillebnm"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="contact-icon github-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.26c-3.34.73-4.04-1.61-4.04-1.61-.55-1.4-1.33-1.77-1.33-1.77-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.62-2.81 5.65-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z"
          />
        </svg>
      </div>

      <div class="contact-info">
        <span class="contact-label">GitHub</span>
        <span class="contact-value">camillebnm</span>
      </div>

      <span class="contact-arrow">↗</span>
    </a>


    <!-- Email -->
    <a
      class="contact-card"
      href="mailto:camille.buonomo@liris.cnrs.fr"
    >
      <div class="contact-icon email-icon">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 5.5h18v13H3zM3.5 6l8.5 7 8.5-7"
          />
        </svg>
      </div>

      <div class="contact-info">
        <span class="contact-label">Email</span>
        <span class="contact-value">
          camille.buonomo <b>at</b> liris.cnrs.fr
        </span>
      </div>

      <span class="contact-arrow">↗</span>
    </a>


    <!-- HAL -->
    <a
      class="contact-card"
      href="https://hal.science/search/index/?q=camille-buonomo"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="contact-icon hal-icon contact-text-icon">
        HAL
      </div>

      <div class="contact-info">
        <span class="contact-label">HAL</span>
        <span class="contact-value">camille-buonomo</span>
      </div>

      <span class="contact-arrow">↗</span>
    </a>


    <!-- ORCID -->
    <a
      class="contact-card"
      href="https://orcid.org/0009-0000-0391-3858"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="contact-icon orcid-icon">
        <span>iD</span>
      </div>

      <div class="contact-info">
        <span class="contact-label">ORCID</span>
        <span class="contact-value">0009-0000-0391-3858</span>
      </div>

      <span class="contact-arrow">↗</span>
    </a>


    <!-- LIRIS -->
    <a
      class="contact-card"
      href="https://liris.cnrs.fr/page-membre/camille-buonomo"
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="contact-icon liris-icon">
        <img src="/icons/logo-liris.svg" alt="" />
      </div>

      <div class="contact-info">
        <span class="contact-label">LIRIS</span>
        <span class="contact-value">Member page</span>
      </div>

      <span class="contact-arrow">↗</span>
    </a>

  </section>
</BaseLayout>